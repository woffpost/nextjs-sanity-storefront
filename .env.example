# Copy to .env.local and fill in real values. Never commit .env.local.

# Sanity — from manage.sanity.io, or printed by `npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# A token with Viewer rights, used server- and browser-side for draft/live
# reads (Presentation tool, Live Preview). Create one at
# manage.sanity.io -> API -> Tokens.
SANITY_API_READ_TOKEN=

# A token with Editor rights, used only by the Stripe webhook to write
# `order` documents and decrement stock. Keep this one server-only.
SANITY_API_WRITE_TOKEN=

# Stripe — test-mode keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the webhook's settings
# page in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=

# Used to build absolute URLs for Stripe redirect/webhook targets and the
# Presentation tool's preview iframe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
